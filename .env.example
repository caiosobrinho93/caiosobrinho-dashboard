# Fase 2 — Supabase
# Copie os valores do painel do Supabase (Project Settings > API).
# Enquanto URL e chave não existirem, o dashboard funciona 100% local.

NEXT_PUBLIC_SUPABASE_URL=
# Chave publicável do projeto (recomendada)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Projetos antigos podem usar a chave anon legada no lugar da publicável:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública usada nos links de confirmação e recuperação de senha.
# No Android/Capacitor, sem esta variável o Supabase usa a Site URL do projeto.
# Ex.: https://dashboard-pessoal.vercel.app
NEXT_PUBLIC_APP_URL=
