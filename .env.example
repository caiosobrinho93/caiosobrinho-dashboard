# Fase 2 — Supabase
# Copie estes valores do painel do Supabase (Project Settings > API).
# Enquanto as duas variáveis não existirem, o dashboard funciona 100% local.

NEXT_PUBLIC_SUPABASE_URL=
# Chave publicável do projeto (recomendada)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Projetos antigos podem usar a chave anon legada no lugar da publicável:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
